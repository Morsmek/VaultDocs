# Optional: override the signaling server (defaults to same-origin /signaling)
# VITE_SIGNALING_URL=wss://your-signaling.example

# Optional: TURN server for restrictive NATs / mobile networks
# Without TURN, peers on some networks cannot form a direct WebRTC link.
# VITE_TURN_URL=turn:turn.example.com:3478
# VITE_TURN_USERNAME=user
# VITE_TURN_CREDENTIAL=secret
